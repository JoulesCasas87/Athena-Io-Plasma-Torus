<comment>
Io plasma torus simulation with toggles for injection, drag, diffusion, losses,
and Dawn-Dusk Asymmetry
</comment>

<job>
problem_id = iotorus
</job>

<mesh>
coord   = spherical_polar
nx1     = 720
x1min   = 2.0
x1max   = 20.0

nx2     = 1.0
x2min   = 0
x2max   = 1.0

nx3     = 1.0
x3min   = 0.0
x3max   = 1.0

ix1_bc  = reflecting
ox1_bc  = outflow
ix2_bc  = periodic
ox2_bc  = periodic
ix3_bc  = periodic
ox3_bc  = periodic
</mesh>

<time>
tlim        = 5000.0
dt          = 0.02
cfl_number  = 0.20
</time>

<field>
riemann     = hlld
recon       = plm
B0          = 1e-3
</field>

<output1>
file_type   = tab
dt          = 40.0
id          = cons
variable    = cons
output_dir  = ./outputs/
</output1>

<output2>
file_type   = tab
dt          = 80.0
id          = ringcuts
variable    = prim
output_dir  = ./outputs/
</output2>

<problem>
enable_injection = 1
enable_diffusion = 1
enable_drag      = 1
enable_losses    = 1
enable_dawn_dusk = 1
enable_gravity   = 1

diag_mass       = 1
diag_species    = 1
diag_energy     = 1
diag_bfield     = 1

s_io            = 5.9
src_sigma       = 0.35
src_amp_total   = 0.012
f_O             = 0.4
f_S             = 0.6
Omega_Io        = 0.0036
sigma_phi       = 0.35

u0              = 0.05
u_corot0        = 0.10   # Ω_J (code units)
tau_u           = 250.0
E_pickup        = 0.4    # start conservative

D_r             = 1e-3
tau_loss_O      = 300.0
tau_loss_S      = 600.0
tau_loss_rho    = 7000.0

A_dd            = 0.15   # slightly reduced for stability
omega_rot       = 1.0

rho0            = 1e-3
p0              = 1.0

GM_custom       = 0.02
g_taper_width   = 0.8
</problem>

<hydro>
gamma   = 1.05
dfloor  = 1e-12
pfloor  = 1e-12
</hydro>

<output3>
file_type   = tab
dt          = 40.0
id          = scal
variable    = cons  # if your build exposes scalars; else keep 'cons' and parse indices
output_dir  = ./outputs/
</output3>

<output4>
file_type   = tab
dt          = 100.0
id          = diag
variable    = prim
output_dir  = ./outputs/
</output4>

<output5>
file_type = tab
dt = 20.0
id = prim
variable = prim
output_dir = ./outputs/